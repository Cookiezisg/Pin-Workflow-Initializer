    "vitest": "^3.2.7",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "idb": "^8.0.4",
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  }
}
