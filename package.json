{
  "name": "pin-workflow-initializer",
  "description": "Workspace engine for Chrome: declarative pinned tabs, workspaces, snapshots, command palette, rules and AI grouping.",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
